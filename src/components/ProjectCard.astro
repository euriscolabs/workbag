---
// Full-width project card: title + status pill on one line (mirroring the
// project page header), description, then category/tag chips. The whole
// card is clickable via the stretched title link.
import StatusPill from "./StatusPill.astro";
import Chips from "./Chips.astro";
import type { PageMeta } from "../lib/content";

interface Props {
  project: PageMeta;
}
const { project: p } = Astro.props;
// Filter hooks for the projects page script
const searchText = [p.title, p.description, p.category ?? "", ...p.tags].join(" ").toLowerCase();
---

<li
  data-status={p.status ?? ""}
  data-tags={p.tags.join("|")}
  data-search={searchText}
  class="group relative border border-border rounded-lg p-5 transition hover:border-blue hover:-translate-y-0.5 hover:shadow-sm"
>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <a
      href={p.url}
      class="text-base font-semibold text-navy no-underline group-hover:text-blue transition-colors after:absolute after:inset-0"
    >
      {p.title}
    </a>
    <StatusPill status={p.status} />
  </div>
  {p.description && <p class="text-sm text-muted leading-relaxed mt-1">{p.description}</p>}
  <Chips category={p.category} tags={p.tags} class="mt-3" />
</li>
