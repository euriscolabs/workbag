---
// The single page layout for every markdown/MDX page on the site.
// Rendering is driven entirely by frontmatter data:
//   - the root page ("/") renders the home shell: no breadcrumbs or title
//     header, the markdown body is the whole page (.home-body CSS)
//   - cards: true styles link lists as card tiles (map/MOC pages)
//   - status, severity, priority, category, tags render as badges/chips
//     whenever present
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import StatusPill from "../components/StatusPill.astro";
import Chips from "../components/Chips.astro";
import { breadcrumbsFor, titleFromSegment } from "../lib/content";

const { frontmatter } = Astro.props;
const url = frontmatter.url || Astro.url.pathname;
const isHome = url === "/";
const title =
  frontmatter.title ?? titleFromSegment(url.split("/").filter(Boolean).pop() ?? "");
const description = frontmatter.description || "";
const breadcrumbs = breadcrumbsFor(url, title);
---

{
  isHome ? (
    <BaseLayout title="Eurisco Labs" description={description}>
      <main class="home-body moc-body max-w-4xl mx-auto px-6 pt-20 sm:pt-28 pb-16">
        <slot />
      </main>
    </BaseLayout>
  ) : (
    <BaseLayout title={`${title} — Eurisco Labs`} description={description}>
      <main class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
        <Breadcrumbs crumbs={breadcrumbs} />

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
          <h1 class="text-2xl sm:text-3xl font-bold text-navy">{title}</h1>
          <StatusPill status={frontmatter.status} />
        </div>
        {description && (
          <p class="text-muted leading-relaxed mb-6">{description}</p>
        )}
        <Chips
          severity={frontmatter.severity}
          priority={frontmatter.priority}
          category={frontmatter.category}
          tags={frontmatter.tags}
          class="mb-8"
        />

        <div
          class:list={[
            frontmatter.cards && "moc-body",
            "prose prose-sm max-w-none border-t border-border pt-8",
          ]}
        >
          <slot />
        </div>
      </main>
    </BaseLayout>
  )
}
