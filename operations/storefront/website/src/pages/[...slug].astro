---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { entryTitle, titleFromSegment, inferType } from "../lib/content";
import type { ContentEntry, ContentType } from "../lib/content";

interface Crumb {
  label: string;
  href: string;
}

export async function getStaticPaths() {
  // Every published markdown file is a page at its entry id (the glob
  // loader github-slugs each path segment). Navigation between pages is
  // managed entirely by MOC pages linking onward — there is no computed
  // tree and no virtual pages for folders without an index.md.
  // `published: false` hides a page and everything beneath it.
  const all = await getCollection("content");
  const draftRoots = all
    .filter((e) => e.data.published === false)
    .map((e) => e.id);
  const published = all.filter(
    (e) => !draftRoots.some((id) => e.id === id || e.id.startsWith(id + "/"))
  );
  const byId = new Map(published.map((e) => [e.id, e]));

  function crumbsFor(entry: ContentEntry): Crumb[] {
    const crumbs: Crumb[] = [{ label: "Home", href: "/" }];
    const segments = entry.id.split("/");
    for (let i = 0; i < segments.length - 1; i++) {
      const ancestorId = segments.slice(0, i + 1).join("/");
      const ancestor = byId.get(ancestorId);
      crumbs.push({
        label: ancestor ? entryTitle(ancestor) : titleFromSegment(segments[i]),
        href: ancestor ? `/${ancestorId}` : "",
      });
    }
    crumbs.push({ label: entryTitle(entry), href: "" });
    return crumbs;
  }

  return published
    .filter((entry) => entry.id !== "index") // root MOC renders on the home page
    .map((entry) => ({
      params: { slug: entry.id },
      props: {
        entry,
        type: inferType(
          entry,
          published.some((e) => e.id.startsWith(entry.id + "/"))
        ),
        breadcrumbs: crumbsFor(entry),
      },
    }));
}

const { entry, type, breadcrumbs } = Astro.props as {
  entry: ContentEntry;
  type: ContentType;
  breadcrumbs: Crumb[];
};

const title = entryTitle(entry);
const description = entry.data.description || "";
const hasBody = !!entry.body?.trim();
const { Content } = await render(entry);

function badgeColor(level: string): string {
  switch (level) {
    case "Critical":
      return "text-red-700 bg-red-100";
    case "High":
      return "text-orange-700 bg-orange-100";
    case "Medium":
      return "text-yellow-700 bg-yellow-100";
    default:
      return "text-gray-700 bg-gray-100";
  }
}
---

<BaseLayout title={`${title} — Eurisco Labs`} description={description}>
  <main class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
    {/* Breadcrumb navigation — ancestors without a page render as plain text */}
    <nav class="text-sm text-muted mb-8 flex items-center gap-1.5 flex-wrap">
      {
        breadcrumbs.map((crumb, i) => (
          <>
            {i > 0 && <span class="text-gray-300">/</span>}
            {crumb.href && i < breadcrumbs.length - 1 ? (
              <a
                href={crumb.href}
                class="hover:text-blue transition-colors no-underline"
              >
                {crumb.label}
              </a>
            ) : (
              <span
                class={
                  i === breadcrumbs.length - 1 ? "text-navy font-medium" : ""
                }
              >
                {crumb.label}
              </span>
            )}
          </>
        ))
      }
    </nav>

    {/* MOC rendering — title + description, the map itself is the body */}
    {
      type === "moc" && (
        <>
          <h1 class="text-2xl sm:text-3xl font-bold text-navy mb-4">{title}</h1>
          {description && (
            <p class="text-muted leading-relaxed mb-6">{description}</p>
          )}
        </>
      )
    }

    {/* Project rendering — status badge + tags */}
    {
      type === "project" && (
        <>
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <h1 class="text-2xl sm:text-3xl font-bold text-navy">{title}</h1>
            {entry.data.status && (
              <span class="text-xs font-medium text-blue bg-blue/10 px-3 py-1 rounded-full w-fit">
                {entry.data.status}
              </span>
            )}
          </div>
          {description && (
            <p class="text-muted leading-relaxed mb-6">{description}</p>
          )}
          {entry.data.tags?.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-8">
              {entry.data.category && (
                <span class="text-xs font-medium text-navy bg-navy/10 px-2 py-0.5 rounded">
                  {entry.data.category}
                </span>
              )}
              {entry.data.tags.map((tag: string) => (
                <span class="text-xs text-muted border border-gray-200 px-2 py-0.5 rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </>
      )
    }

    {/* Article rendering — severity/priority badge */}
    {
      type === "article" && (
        <>
          <h1 class="text-2xl sm:text-3xl font-bold text-navy mb-4">{title}</h1>
          {description && (
            <p class="text-muted leading-relaxed mb-4">{description}</p>
          )}
          {(entry.data.severity || entry.data.priority || entry.data.category) && (
            <div class="flex flex-wrap gap-2 mb-8">
              {entry.data.severity && (
                <span
                  class={`text-xs font-medium px-2 py-0.5 rounded ${badgeColor(entry.data.severity)}`}
                >
                  {entry.data.severity} severity
                </span>
              )}
              {entry.data.priority && (
                <span
                  class={`text-xs font-medium px-2 py-0.5 rounded ${badgeColor(entry.data.priority)}`}
                >
                  {entry.data.priority} priority
                </span>
              )}
              {entry.data.category && (
                <span class="text-xs text-muted border border-gray-200 px-2 py-0.5 rounded">
                  {entry.data.category}
                </span>
              )}
            </div>
          )}
        </>
      )
    }

    {/* Markdown content */}
    {
      hasBody && (
        <div
          class="border-t border-gray-200 pt-8 prose prose-slate max-w-none
      [&_h1]:text-xl [&_h1]:font-semibold [&_h1]:text-navy [&_h1]:mt-8 [&_h1]:mb-4
      [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-navy [&_h2]:mt-6 [&_h2]:mb-3
      [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-navy [&_h3]:mt-4 [&_h3]:mb-2
      [&_p]:text-sm [&_p]:text-muted [&_p]:leading-relaxed [&_p]:mb-4
      [&_ul]:text-sm [&_ul]:text-muted [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5
      [&_ol]:text-sm [&_ol]:text-muted [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-5
      [&_li]:mb-1
      [&_a]:text-blue [&_a]:underline
      [&_code]:text-sm [&_code]:bg-gray-100 [&_code]:px-1 [&_code]:rounded
      [&_table]:text-sm [&_table]:w-full [&_table]:mb-4
      [&_th]:text-left [&_th]:text-navy [&_th]:font-medium [&_th]:pb-2 [&_th]:border-b [&_th]:border-gray-200
      [&_td]:py-1.5 [&_td]:text-muted [&_td]:border-b [&_td]:border-gray-100"
        >
          <Content />
        </div>
      )
    }
  </main>
</BaseLayout>
