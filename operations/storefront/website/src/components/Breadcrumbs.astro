---
export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

{/* Ancestors without a page of their own render as plain text */}
<nav class="text-sm text-muted mb-8 flex items-center gap-1.5 flex-wrap">
  {
    crumbs.map((crumb, i) => (
      <>
        {i > 0 && <span class="text-gray-300">/</span>}
        {crumb.href && i < crumbs.length - 1 ? (
          <a
            href={crumb.href}
            class="hover:text-blue transition-colors no-underline"
          >
            {crumb.label}
          </a>
        ) : (
          <span class={i === crumbs.length - 1 ? "text-navy font-medium" : ""}>
            {crumb.label}
          </span>
        )}
      </>
    ))
  }
</nav>
