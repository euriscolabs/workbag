---
// Layout for knowledge-base articles: title + severity/priority badges.
// Used natively via frontmatter, e.g.:
//   layout: ../../layouts/ArticleLayout.astro
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { breadcrumbsFor, titleFromSegment } from "../lib/content";
import { proseClasses } from "../lib/prose";

const { frontmatter } = Astro.props;
const url = frontmatter.url || Astro.url.pathname;
const title =
  frontmatter.title ?? titleFromSegment(url.split("/").filter(Boolean).pop() ?? "");
const description = frontmatter.description || "";
const breadcrumbs = breadcrumbsFor(url, title);

function badgeColor(level: string): string {
  switch (level) {
    case "Critical":
      return "text-red-700 bg-red-100";
    case "High":
      return "text-orange-700 bg-orange-100";
    case "Medium":
      return "text-yellow-700 bg-yellow-100";
    default:
      return "text-gray-700 bg-gray-100";
  }
}
---

<BaseLayout title={`${title} — Eurisco Labs`} description={description}>
  <main class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
    <Breadcrumbs crumbs={breadcrumbs} />

    <h1 class="text-2xl sm:text-3xl font-bold text-navy mb-4">{title}</h1>
    {description && <p class="text-muted leading-relaxed mb-4">{description}</p>}
    {
      (frontmatter.severity || frontmatter.priority || frontmatter.category) && (
        <div class="flex flex-wrap gap-2 mb-8">
          {frontmatter.severity && (
            <span
              class={`text-xs font-medium px-2 py-0.5 rounded ${badgeColor(frontmatter.severity)}`}
            >
              {frontmatter.severity} severity
            </span>
          )}
          {frontmatter.priority && (
            <span
              class={`text-xs font-medium px-2 py-0.5 rounded ${badgeColor(frontmatter.priority)}`}
            >
              {frontmatter.priority} priority
            </span>
          )}
          {frontmatter.category && (
            <span class="text-xs text-muted border border-gray-200 px-2 py-0.5 rounded">
              {frontmatter.category}
            </span>
          )}
        </div>
      )
    }

    <div class={proseClasses}>
      <slot />
    </div>
  </main>
</BaseLayout>
