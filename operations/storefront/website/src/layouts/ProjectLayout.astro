---
// Layout for project pages: title + status badge, description, tags.
// Used natively via frontmatter, e.g.:
//   layout: ../../layouts/ProjectLayout.astro
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { breadcrumbsFor, titleFromSegment } from "../lib/content";
import { proseClasses } from "../lib/prose";

const { frontmatter } = Astro.props;
const url = frontmatter.url || Astro.url.pathname;
const title =
  frontmatter.title ?? titleFromSegment(url.split("/").filter(Boolean).pop() ?? "");
const description = frontmatter.description || "";
const breadcrumbs = breadcrumbsFor(url, title);
---

<BaseLayout title={`${title} — Eurisco Labs`} description={description}>
  <main class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
    <Breadcrumbs crumbs={breadcrumbs} />

    <div
      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4"
    >
      <h1 class="text-2xl sm:text-3xl font-bold text-navy">{title}</h1>
      {
        frontmatter.status && (
          <span class="text-xs font-medium text-blue bg-blue/10 px-3 py-1 rounded-full w-fit">
            {frontmatter.status}
          </span>
        )
      }
    </div>
    {description && <p class="text-muted leading-relaxed mb-6">{description}</p>}
    {
      frontmatter.tags?.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {frontmatter.category && (
            <span class="text-xs font-medium text-navy bg-navy/10 px-2 py-0.5 rounded">
              {frontmatter.category}
            </span>
          )}
          {frontmatter.tags.map((tag: string) => (
            <span class="text-xs text-muted border border-gray-200 px-2 py-0.5 rounded">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div class={proseClasses}>
      <slot />
    </div>
  </main>
</BaseLayout>
